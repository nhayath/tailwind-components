<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DealFinder - Best Deals & Discounts</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'media',
            theme: {
                extend: {
                    colors: {
                        primary: {
                            50: '#eff6ff',
                            500: '#3b82f6',
                            600: '#2563eb',
                            700: '#1d4ed8'
                        },
                        accent: {
                            500: '#10b981',
                            600: '#059669'
                        }
                    }
                }
            }
        }
    </script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        @media (max-width: 768px) {
            html { color-scheme: dark; }
        }
        @media (min-width: 769px) {
            html { color-scheme: light; }
        }
    </style>
</head>
<body class="bg-white dark:bg-gray-900 text-gray-900 dark:text-white transition-colors duration-300 pb-16 md:pb-0">
    <!-- Header -->
    <header class="sticky top-0 z-50 bg-white/95 dark:bg-gray-900/95 backdrop-blur-sm border-b border-gray-200 dark:border-gray-700">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <!-- Mobile: Logo and Search Side by Side -->
                <div class="flex items-center space-x-3 flex-1 md:flex-none">
                    <!-- Logo -->
                    <div class="flex items-center space-x-2 flex-shrink-0">
                        <div class="w-8 h-8 bg-gradient-to-r from-primary-500 to-accent-500 rounded-lg flex items-center justify-center">
                            <i class="fas fa-tag text-white text-sm"></i>
                        </div>
                        <span class="text-lg md:text-xl font-bold bg-gradient-to-r from-primary-600 to-accent-600 bg-clip-text text-transparent">
                            DealFinder
                        </span>
                    </div>
                    
                    <!-- Mobile Search -->
                    <div class="md:hidden flex-1 max-w-xs">
                        <div class="relative">
                            <input type="text" 
                                   placeholder="Search deals..."
                                   class="w-full px-3 py-2 pl-8 pr-3 text-sm border border-gray-300 dark:border-gray-600 rounded-lg bg-gray-50 dark:bg-gray-800 focus:ring-2 focus:ring-primary-500 focus:border-transparent outline-none">
                            <i class="fas fa-search absolute left-2.5 top-1/2 transform -translate-y-1/2 text-gray-400 text-xs"></i>
                        </div>
                    </div>
                </div>

                <!-- Desktop Search Bar -->
                <div class="hidden md:flex flex-1 max-w-lg mx-8">
                    <div class="relative w-full">
                        <input type="text" 
                               placeholder="Search for deals, stores, or products..."
                               class="w-full px-4 py-2 pl-10 pr-4 text-sm border border-gray-300 dark:border-gray-600 rounded-lg bg-gray-50 dark:bg-gray-800 focus:ring-2 focus:ring-primary-500 focus:border-transparent outline-none">
                        <i class="fas fa-search absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400"></i>
                    </div>
                </div>

                <!-- Desktop Navigation -->
                <nav class="hidden md:flex items-center space-x-6">
                    <a href="#" class="text-sm font-medium hover:text-primary-600 dark:hover:text-primary-400 transition-colors">Categories</a>
                    <a href="#" class="text-sm font-medium hover:text-primary-600 dark:hover:text-primary-400 transition-colors">Stores</a>
                    <a href="#" class="text-sm font-medium hover:text-primary-600 dark:hover:text-primary-400 transition-colors">Coupons</a>
                    <button class="bg-primary-600 hover:bg-primary-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition-colors">
                        Sign In
                    </button>
                </nav>
            </div>
        </div>
    </header>

    <!-- Mobile Menu Overlay -->
    <div id="mobileMenuOverlay" class="md:hidden fixed left-0 right-0 top-16 bottom-0 z-50 bg-black bg-opacity-50 hidden">
        <div id="mobileMenu" class="fixed left-0 top-16 bottom-0 w-full bg-gray-900 text-white transform -translate-x-full transition-transform duration-300 ease-in-out">
            <!-- Menu Header -->
            <div class="flex items-center justify-between p-4 border-b border-gray-700">
                <h2 class="text-xl font-bold">Menu</h2>
                <button id="closeMobileMenu" class="p-2 hover:bg-gray-800 rounded-lg transition-colors">
                    <i class="fas fa-times text-lg"></i>
                </button>
            </div>
            
            <!-- Menu Content -->
            <div class="flex flex-col h-full">
                <!-- Main Navigation -->
                <div class="flex-1 py-4">
                    <nav class="space-y-1">
                        <a href="#" class="flex items-center px-4 py-3 text-orange-400 bg-gray-800 border-r-2 border-orange-400">
                            <i class="fas fa-home w-6 text-center mr-3"></i>
                            <span class="font-medium">Home</span>
                        </a>
                        <a href="#" class="flex items-center px-4 py-3 text-gray-300 hover:bg-gray-800 hover:text-white transition-colors">
                            <i class="fas fa-tag w-6 text-center mr-3"></i>
                            <span>Deals</span>
                        </a>
                        <a href="#" class="flex items-center px-4 py-3 text-gray-300 hover:bg-gray-800 hover:text-white transition-colors group">
                            <i class="fas fa-percent w-6 text-center mr-3"></i>
                            <span class="flex-1">Discount Codes</span>
                            <i class="fas fa-chevron-right text-gray-500 group-hover:text-gray-300"></i>
                        </a>
                        <a href="#" class="flex items-center px-4 py-3 text-gray-300 hover:bg-gray-800 hover:text-white transition-colors group">
                            <i class="fas fa-th-large w-6 text-center mr-3"></i>
                            <span class="flex-1">Categories</span>
                            <i class="fas fa-chevron-right text-gray-500 group-hover:text-gray-300"></i>
                        </a>
                        <a href="#" class="flex items-center px-4 py-3 text-gray-300 hover:bg-gray-800 hover:text-white transition-colors">
                            <i class="fas fa-gift w-6 text-center mr-3"></i>
                            <span>Freebies</span>
                        </a>
                        <a href="#" class="flex items-center px-4 py-3 text-gray-300 hover:bg-gray-800 hover:text-white transition-colors">
                            <i class="fas fa-comments w-6 text-center mr-3"></i>
                            <span>Discussions</span>
                        </a>
                        <a href="#" class="flex items-center px-4 py-3 text-gray-300 hover:bg-gray-800 hover:text-white transition-colors">
                            <i class="fas fa-book w-6 text-center mr-3"></i>
                            <span>Magazine</span>
                        </a>
                    </nav>
                    
                    <!-- Highlights Section -->
                    <div class="mt-8 px-4">
                        <h3 class="text-lg font-semibold mb-4">Highlights</h3>
                        <a href="#" class="flex items-center py-3 text-gray-300 hover:text-white transition-colors">
                            <i class="fas fa-star w-6 text-center mr-3"></i>
                            <span>Club</span>
                        </a>
                    </div>
                </div>
                
                <!-- Account Section -->
                <div class="border-t border-gray-700 p-4">
                    <h3 class="text-lg font-semibold mb-4">Account</h3>
                    <button class="w-full bg-primary-600 hover:bg-primary-700 text-white py-3 px-4 rounded-lg font-medium transition-colors">
                        Sign In / Register
                    </button>
                </div>
            </div>
        </div>
        
        <!-- Categories Submenu -->
        <div id="categoriesSubmenu" class="fixed left-0 top-16 bottom-0 w-full bg-gray-900 text-white transform translate-x-full transition-transform duration-300 ease-in-out">
            <!-- Submenu Header -->
            <div class="flex items-center justify-between p-4 border-b border-gray-700">
                <button id="backToMainMenu" class="text-white hover:text-gray-300">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
                    </svg>
                </button>
                <h2 class="text-lg font-semibold">Categories</h2>
                <button id="closeCategoriesMenu" class="text-white hover:text-gray-300">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </button>
            </div>
            
            <!-- Categories List -->
            <div class="p-4 space-y-4">
                <a href="#" class="block py-3 px-4 text-white hover:bg-gray-800 rounded-lg transition-colors">Electronics</a>
                <a href="#" class="block py-3 px-4 text-white hover:bg-gray-800 rounded-lg transition-colors">Fashion</a>
                <a href="#" class="block py-3 px-4 text-white hover:bg-gray-800 rounded-lg transition-colors">Home & Garden</a>
                <a href="#" class="block py-3 px-4 text-white hover:bg-gray-800 rounded-lg transition-colors">Sports & Outdoors</a>
                <a href="#" class="block py-3 px-4 text-white hover:bg-gray-800 rounded-lg transition-colors">Health & Beauty</a>
                <a href="#" class="block py-3 px-4 text-white hover:bg-gray-800 rounded-lg transition-colors">Books & Media</a>
                <a href="#" class="block py-3 px-4 text-white hover:bg-gray-800 rounded-lg transition-colors">Toys & Games</a>
                <a href="#" class="block py-3 px-4 text-white hover:bg-gray-800 rounded-lg transition-colors">Automotive</a>
            </div>
        </div>
    </div>

    <!-- Hero Section -->
    <section class="bg-gradient-to-br from-primary-50 to-accent-50 dark:from-gray-800 dark:to-gray-900 py-12 md:py-20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <h1 class="text-3xl md:text-5xl font-bold mb-6">
                Find the <span class="bg-gradient-to-r from-primary-600 to-accent-600 bg-clip-text text-transparent">Best Deals</span><br>
                Save More Every Day
            </h1>
            <p class="text-lg md:text-xl text-gray-600 dark:text-gray-300 mb-8 max-w-2xl mx-auto">
                Discover amazing discounts, exclusive coupons, and limited-time offers from your favorite brands.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <button class="bg-primary-600 hover:bg-primary-700 text-white px-8 py-3 rounded-lg font-medium transition-colors">
                    Browse Deals
                </button>
                <button class="border border-primary-600 text-primary-600 dark:text-primary-400 hover:bg-primary-50 dark:hover:bg-gray-800 px-8 py-3 rounded-lg font-medium transition-colors">
                    Submit a Deal
                </button>
            </div>
        </div>
    </section>

    <!-- Quick Categories -->
    <section class="py-8 md:py-12">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="text-2xl font-bold mb-6 text-center md:text-left">Popular Categories</h2>
            <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4">
                <div class="bg-white dark:bg-gray-800 rounded-lg p-4 text-center hover:shadow-lg dark:hover:shadow-gray-700/20 transition-shadow border border-gray-200 dark:border-gray-700">
                    <i class="fas fa-laptop text-2xl text-primary-600 mb-2"></i>
                    <p class="text-sm font-medium">Electronics</p>
                </div>
                <div class="bg-white dark:bg-gray-800 rounded-lg p-4 text-center hover:shadow-lg dark:hover:shadow-gray-700/20 transition-shadow border border-gray-200 dark:border-gray-700">
                    <i class="fas fa-tshirt text-2xl text-primary-600 mb-2"></i>
                    <p class="text-sm font-medium">Fashion</p>
                </div>
                <div class="bg-white dark:bg-gray-800 rounded-lg p-4 text-center hover:shadow-lg dark:hover:shadow-gray-700/20 transition-shadow border border-gray-200 dark:border-gray-700">
                    <i class="fas fa-home text-2xl text-primary-600 mb-2"></i>
                    <p class="text-sm font-medium">Home</p>
                </div>
                <div class="bg-white dark:bg-gray-800 rounded-lg p-4 text-center hover:shadow-lg dark:hover:shadow-gray-700/20 transition-shadow border border-gray-200 dark:border-gray-700">
                    <i class="fas fa-gamepad text-2xl text-primary-600 mb-2"></i>
                    <p class="text-sm font-medium">Gaming</p>
                </div>
                <div class="bg-white dark:bg-gray-800 rounded-lg p-4 text-center hover:shadow-lg dark:hover:shadow-gray-700/20 transition-shadow border border-gray-200 dark:border-gray-700">
                    <i class="fas fa-utensils text-2xl text-primary-600 mb-2"></i>
                    <p class="text-sm font-medium">Food</p>
                </div>
                <div class="bg-white dark:bg-gray-800 rounded-lg p-4 text-center hover:shadow-lg dark:hover:shadow-gray-700/20 transition-shadow border border-gray-200 dark:border-gray-700">
                    <i class="fas fa-plane text-2xl text-primary-600 mb-2"></i>
                    <p class="text-sm font-medium">Travel</p>
                </div>
            </div>
