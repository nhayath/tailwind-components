        </div>
    </section>

    <!-- Footer -->
    <footer class="bg-gray-900 text-white py-12">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
                <div>
                    <div class="flex items-center space-x-2 mb-4">
                        <div class="w-8 h-8 bg-gradient-to-r from-primary-500 to-accent-500 rounded-lg flex items-center justify-center">
                            <i class="fas fa-tag text-white text-sm"></i>
                        </div>
                        <span class="text-xl font-bold">DealFinder</span>
                    </div>
                    <p class="text-gray-400 text-sm">Your ultimate destination for the best deals and discounts online.</p>
                </div>
                <div>
                    <h3 class="font-semibold mb-4">Categories</h3>
                    <ul class="space-y-2 text-sm text-gray-400">
                        <li><a href="#" class="hover:text-white transition-colors">Electronics</a></li>
                        <li><a href="#" class="hover:text-white transition-colors">Fashion</a></li>
                        <li><a href="#" class="hover:text-white transition-colors">Home & Garden</a></li>
                        <li><a href="#" class="hover:text-white transition-colors">Travel</a></li>
                    </ul>
                </div>
                <div>
                    <h3 class="font-semibold mb-4">Company</h3>
                    <ul class="space-y-2 text-sm text-gray-400">
                        <li><a href="#" class="hover:text-white transition-colors">About Us</a></li>
                        <li><a href="#" class="hover:text-white transition-colors">Contact</a></li>
                        <li><a href="#" class="hover:text-white transition-colors">Privacy Policy</a></li>
                        <li><a href="#" class="hover:text-white transition-colors">Terms of Service</a></li>
                    </ul>
                </div>
                <div>
                    <h3 class="font-semibold mb-4">Follow Us</h3>
                    <div class="flex space-x-4">
                        <a href="#" class="text-gray-400 hover:text-white transition-colors">
                            <i class="fab fa-facebook text-xl"></i>
                        </a>
                        <a href="#" class="text-gray-400 hover:text-white transition-colors">
                            <i class="fab fa-twitter text-xl"></i>
                        </a>
                        <a href="#" class="text-gray-400 hover:text-white transition-colors">
                            <i class="fab fa-instagram text-xl"></i>
                        </a>
                        <a href="#" class="text-gray-400 hover:text-white transition-colors">
                            <i class="fab fa-youtube text-xl"></i>
                        </a>
                    </div>
                </div>
            </div>
            <div class="border-t border-gray-800 mt-8 pt-8 text-center text-sm text-gray-400">
                <p>&copy; 2024 DealFinder. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <!-- Mobile Bottom Navigation -->
    <nav class="md:hidden fixed bottom-0 left-0 right-0 z-50 bg-white dark:bg-gray-900 border-t border-gray-200 dark:border-gray-700">
        <div class="grid grid-cols-4 h-16">
            <!-- Menu -->
            <button id="openMobileMenu" class="flex flex-col items-center justify-center space-y-1 text-gray-600 dark:text-gray-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors">
                <i class="fas fa-bars text-lg"></i>
                <span class="text-xs font-medium">Menu</span>
            </button>
            
            <!-- Alerts -->
            <a href="#" class="flex flex-col items-center justify-center space-y-1 text-gray-600 dark:text-gray-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors">
                <i class="fas fa-bell text-lg"></i>
                <span class="text-xs font-medium">Alerts</span>
            </a>
            
            <!-- Post -->
            <a href="#" class="flex flex-col items-center justify-center space-y-1 text-gray-600 dark:text-gray-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors">
                <i class="fas fa-plus-square text-lg"></i>
                <span class="text-xs font-medium">Post</span>
            </a>
            
            <!-- Log In -->
            <a href="#" class="flex flex-col items-center justify-center space-y-1 text-gray-600 dark:text-gray-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors">
                <i class="fas fa-user text-lg"></i>
                <span class="text-xs font-medium">Log In</span>
            </a>
        </div>
    </nav>

    <script>
        // Mobile Menu Toggle Functionality
        const openMenuBtn = document.getElementById('openMobileMenu');
        const closeMenuBtn = document.getElementById('closeMobileMenu');
        const menuOverlay = document.getElementById('mobileMenuOverlay');
        const mobileMenu = document.getElementById('mobileMenu');

        function openMobileMenu() {
            menuOverlay.classList.remove('hidden');
            setTimeout(() => {
                mobileMenu.classList.remove('-translate-x-full');
            }, 10);
        }

        function closeMobileMenu() {
            mobileMenu.classList.add('-translate-x-full');
            setTimeout(() => {
                menuOverlay.classList.add('hidden');
            }, 300);
        }

        function showCategoriesMenu() {
            const mainMenu = document.getElementById('mobileMenu');
            const categoriesMenu = document.getElementById('categoriesSubmenu');
            
            // Push main menu to the left and slide categories in from right
            mainMenu.style.transform = 'translateX(-100%)';
            categoriesMenu.classList.remove('translate-x-full');
            categoriesMenu.classList.add('translate-x-0');
        }

        function showMainMenu() {
            const mainMenu = document.getElementById('mobileMenu');
            const categoriesMenu = document.getElementById('categoriesSubmenu');
            
            // Slide categories out to right and bring main menu back
            categoriesMenu.classList.remove('translate-x-0');
            categoriesMenu.classList.add('translate-x-full');
            mainMenu.style.transform = 'translateX(0)';
        }

        function closeAllMenus() {
            const overlay = document.getElementById('mobileMenuOverlay');
            const mainMenu = document.getElementById('mobileMenu');
            const categoriesMenu = document.getElementById('categoriesSubmenu');
            
            overlay.classList.add('hidden');
            mainMenu.classList.add('-translate-x-full');
            mainMenu.classList.remove('translate-x-0');
            categoriesMenu.classList.add('translate-x-full');
            categoriesMenu.classList.remove('translate-x-0');
            
            // Reset any inline transforms
            mainMenu.style.transform = '';
        }

        // Event listeners
        openMenuBtn.addEventListener('click', openMobileMenu);
        closeMenuBtn.addEventListener('click', closeAllMenus);
        
        // Categories submenu event listeners
        const backToMainBtn = document.getElementById('backToMainMenu');
        const closeCategoriesBtn = document.getElementById('closeCategoriesMenu');
        const categoriesBtn = document.querySelector('a[href="#"] i.fas.fa-th-large').parentElement;
        
        categoriesBtn.addEventListener('click', showCategoriesMenu);
        backToMainBtn.addEventListener('click', showMainMenu);
        closeCategoriesBtn.addEventListener('click', closeAllMenus);
        
        // Close menu when clicking overlay
        menuOverlay.addEventListener('click', (e) => {
            if (e.target === menuOverlay) {
                closeMobileMenu();
            }
        });

        // Close menu on escape key
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && !menuOverlay.classList.contains('hidden')) {
                closeMobileMenu();
            }
        });
    </script>
</body>
</html>